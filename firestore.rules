rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "otCHJNeKfgbohIs1lVn7O7RD5m73";
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =====================================================
    // STUDENT USERS
    // New users store separate class/room/department/major fields.
    // Old profiles remain readable for backward compatibility.
    // =====================================================
    match /studentUsers/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.studentId is string
        && request.resource.data.name is string
        && request.resource.data.className is string
        && request.resource.data.department is string;

      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================
    // QUESTIONS
    // =====================================================
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // ANSWER KEYS
    // =====================================================
    match /answerKeys/{questionId} {
      allow read, create, update, delete: if isAdmin();
    }

    // =====================================================
    // STUDENT CHECK-INS
    // Best-effort tracking; never required to start exam.
    // =====================================================
    match /studentCheckins/{checkinId} {
      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.ownerUid == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
        );

      allow read, delete: if isAdmin();
    }

    // =====================================================
    // SUBMISSIONS — CRITICAL PATH
    // Student sends answers directly. No registration/attempt
    // document is required to submit.
    // =====================================================
    match /submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.student is map
        && request.resource.data.student.studentId is string
        && request.resource.data.subjectId is string
        && request.resource.data.subjectCode is string
        && request.resource.data.subjectName is string
        && request.resource.data.questionIds is list
        && request.resource.data.selectedOriginal is list
        && request.resource.data.questionIds.size() == 50
        && request.resource.data.selectedOriginal.size() == 50;

      allow read, update, delete: if isAdmin();
    }

    // =====================================================
    // STUDENT REQUESTS
    // =====================================================
    match /examRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.subjectId is string
        && request.resource.data.submissionId is string
        && request.resource.data.status == "pending";

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    // =====================================================
    // OLD COLLECTIONS
    // Not required to start or submit an exam.
    // =====================================================
    match /registrations/{registrationId} {
      allow read, write: if isAdmin();
    }

    match /examAttempts/{attemptId} {
      allow read, write: if isAdmin();
    }

    // =====================================================
    // SUBJECTS / SETTINGS
    // =====================================================
    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /examSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
