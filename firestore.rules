rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "otCHJNeKfgbohIs1lVn7O7RD5m73";
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =====================================================
    // STUDENT USER PROFILE
    // =====================================================
    match /studentUsers/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.studentId is string
        && request.resource.data.name is string
        && request.resource.data.className is string
        && request.resource.data.department is string;

      allow read: if isOwner(uid) || isAdmin();

      // Student can maintain own profile; Admin can manage all users.
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================
    // QUESTIONS
    // =====================================================
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // ANSWER KEYS
    // =====================================================
    match /answerKeys/{questionId} {
      allow read, create, update, delete: if isAdmin();
    }

    // =====================================================
    // STUDENT CHECK-INS
    // =====================================================
    match /studentCheckins/{checkinId} {
      function validCheckin() {
        return request.resource.data.studentId is string
          && request.resource.data.name is string
          && request.resource.data.className is string
          && request.resource.data.department is string
          && request.resource.data.status is string;
      }

      allow create: if
        (
          isAdmin()
          || (
            signedIn()
            && request.resource.data.ownerUid == request.auth.uid
          )
          // backward compatibility for old anonymous records
          || request.auth == null
        )
        && validCheckin();

      allow update: if
        isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && validCheckin()
        )
        || (
          request.auth == null
          && validCheckin()
          && resource.data.studentId == request.resource.data.studentId
          && resource.data.name == request.resource.data.name
        );

      allow read, delete: if isAdmin();
    }

    // =====================================================
    // EXAM REGISTRATIONS
    // =====================================================
    match /registrations/{registrationId} {
      function validRegistration() {
        return request.resource.data.studentId is string
          && request.resource.data.name is string
          && request.resource.data.className is string
          && request.resource.data.department is string
          && request.resource.data.subjectId is string
          && request.resource.data.subjectCode is string
          && request.resource.data.subjectName is string
          && request.resource.data.attemptToken is string
          && request.resource.data.status == "started";
      }

      allow create: if
        (
          isAdmin()
          || (
            signedIn()
            && request.resource.data.ownerUid == request.auth.uid
          )
          || request.auth == null
        )
        && validRegistration();

      allow update: if
        isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && validRegistration()
        )
        || (
          request.auth == null
          && validRegistration()
          && resource.data.studentId == request.resource.data.studentId
          && resource.data.subjectId == request.resource.data.subjectId
        );

      allow read, delete: if isAdmin();
    }

    // =====================================================
    // SUBMISSIONS
    // =====================================================
    match /submissions/{submissionId} {
      allow create: if
        (
          isAdmin()
          || (
            signedIn()
            && request.resource.data.ownerUid == request.auth.uid
          )
          || request.auth == null
        )
        && request.resource.data.registrationId is string
        && request.resource.data.attemptToken is string
        && request.resource.data.subjectId is string
        && request.resource.data.subjectCode is string
        && request.resource.data.subjectName is string
        && request.resource.data.student.studentId is string
        && request.resource.data.questionIds is list
        && request.resource.data.selectedOriginal is list
        && request.resource.data.questionIds.size() == 50
        && request.resource.data.selectedOriginal.size() == 50
        && exists(
          /databases/$(database)/documents/registrations/$(request.resource.data.registrationId)
        )
        && get(
          /databases/$(database)/documents/registrations/$(request.resource.data.registrationId)
        ).data.attemptToken == request.resource.data.attemptToken
        && get(
          /databases/$(database)/documents/registrations/$(request.resource.data.registrationId)
        ).data.studentId == request.resource.data.student.studentId
        && get(
          /databases/$(database)/documents/registrations/$(request.resource.data.registrationId)
        ).data.subjectId == request.resource.data.subjectId;

      allow read, update, delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /examSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
