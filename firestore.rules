rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "NOy0qe3lgLbgvoVhuxHBeq7ZVYs2";
    }

    // นักเรียนอ่านเฉพาะโจทย์และตัวเลือก ไม่มีเฉลยใน collection นี้
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // เฉลยและเหตุผลอ่าน/เขียนได้เฉพาะ Admin
    match /answerKeys/{questionId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ลงทะเบียนได้ครั้งเดียวต่อ document id (hash ของเลขนักศึกษา)
    // นักเรียนไม่มีสิทธิ์อ่านรายชื่อหรือแก้ไขข้อมูลหลังลงทะเบียน
    match /registrations/{registrationId} {
      allow create: if request.auth == null
        && request.resource.data.studentId is string
        && request.resource.data.name is string
        && request.resource.data.className is string
        && request.resource.data.department is string
        && request.resource.data.attemptToken is string
        && request.resource.data.status == "started";
      allow read, update, delete: if isAdmin();
    }

    // นักเรียนส่งคำตอบได้เมื่อมี token ตรงกับการลงทะเบียนของตน
    // คะแนนไม่ถูกบันทึกจาก client และอ่านผลได้เฉพาะ Admin
    match /submissions/{submissionId} {
      allow create: if request.auth == null
        && request.resource.data.registrationId is string
        && request.resource.data.attemptToken is string
        && request.resource.data.student.studentId is string
        && request.resource.data.questionIds is list
        && request.resource.data.selectedOriginal is list
        && request.resource.data.questionIds.size() == 50
        && request.resource.data.selectedOriginal.size() == 50
        && exists(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId))
        && get(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.attemptToken == request.resource.data.attemptToken
        && get(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.studentId == request.resource.data.student.studentId;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
