rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "otCHJNeKfgbohIs1lVn7O7RD5m73";
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =====================================================
    // STUDENT USER PROFILE
    // =====================================================
    match /studentUsers/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.studentId is string
        && request.resource.data.name is string
        && request.resource.data.className is string
        && request.resource.data.department is string;

      allow read: if isOwner(uid) || isAdmin();

      // Student can maintain own profile; Admin can manage all users.
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // =====================================================
    // QUESTIONS
    // =====================================================
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // ANSWER KEYS
    // =====================================================
    match /answerKeys/{questionId} {
      allow read, create, update, delete: if isAdmin();
    }

    // =====================================================
    // STUDENT CHECK-INS
    // =====================================================
    match /studentCheckins/{checkinId} {
      function validCheckin() {
        return request.resource.data.studentId is string
          && request.resource.data.name is string
          && request.resource.data.className is string
          && request.resource.data.department is string
          && request.resource.data.status is string;
      }

      allow create: if
        (
          isAdmin()
          || (
            signedIn()
            && request.resource.data.ownerUid == request.auth.uid
          )
          // backward compatibility for old anonymous records
          || request.auth == null
        )
        && validCheckin();

      allow update: if
        isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && validCheckin()
        )
        || (
          request.auth == null
          && validCheckin()
          && resource.data.studentId == request.resource.data.studentId
          && resource.data.name == request.resource.data.name
        );

      allow read, delete: if isAdmin();
    }

    // =====================================================
    // EXAM ATTEMPT LIMIT
    // 1 User x 1 Subject = maximum 2 attempts
    // =====================================================
    match /examAttempts/{attemptId} {

      function ownAttemptCreate() {
        return signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.studentId is string
          && request.resource.data.subjectId is string
          && request.resource.data.attemptsUsed == 1
          && request.resource.data.terminatedCount == 0
          && request.resource.data.maxAttempts == 2;
      }

      function ownAttemptUpdate() {
        return signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.maxAttempts == 2
          && request.resource.data.attemptsUsed >= 0
          && request.resource.data.attemptsUsed <= 2
          && request.resource.data.terminatedCount >= 0
          && request.resource.data.terminatedCount <= request.resource.data.attemptsUsed
          && (
            // ใช้สิทธิ์สอบใหม่: +1 ครั้ง
            (
              request.resource.data.attemptsUsed == resource.data.attemptsUsed + 1
              && request.resource.data.terminatedCount == resource.data.terminatedCount
            )
            ||
            // บันทึกการถูกยุติ: terminated +1
            (
              request.resource.data.attemptsUsed == resource.data.attemptsUsed
              && request.resource.data.terminatedCount == resource.data.terminatedCount + 1
            )
          );
      }

      allow create: if isAdmin() || ownAttemptCreate();
      allow update: if isAdmin() || ownAttemptUpdate();

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // =====================================================
    // EXAM REGISTRATIONS
    // =====================================================
    match /registrations/{registrationId} {
      function validRegistration() {
        return request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.studentId is string
          && request.resource.data.name is string
          && request.resource.data.className is string
          && request.resource.data.department is string
          && request.resource.data.subjectId is string
          && request.resource.data.subjectCode is string
          && request.resource.data.subjectName is string
          && request.resource.data.attemptToken is string
          && request.resource.data.attemptNumber is int
          && request.resource.data.attemptNumber >= 1
          && request.resource.data.attemptNumber <= 2
          && request.resource.data.maxAttempts == 2
          && request.resource.data.status == "started";
      }

      // Student creates a NEW registration for every attempt.
      allow create: if isAdmin()
        || (
          signedIn()
          && validRegistration()
        );

      // Student never needs to overwrite a registration.
      allow read, update, delete: if isAdmin();
    }

    // =====================================================
    // SUBMISSIONS
    // =====================================================
    match /submissions/{submissionId} {
      allow create: if
        (
          isAdmin()
          || (
            signedIn()
            && request.resource.data.ownerUid == request.auth.uid
          )
          || request.auth == null
        )
        && request.resource.data.registrationId is string
        && request.resource.data.attemptToken is string
        && request.resource.data.subjectId is string
        && request.resource.data.subjectCode is string
        && request.resource.data.subjectName is string
        && request.resource.data.student.studentId is string
        && request.resource.data.questionIds is list
        && request.resource.data.selectedOriginal is list
        && request.resource.data.questionIds.size() == 50
        && request.resource.data.selectedOriginal.size() == 50
        && exists(
          /databases/$(database)/documents/registrations/$(request.resource.data.registrationId)
        )
        && get(
          /databases/$(database)/documents/registrations/$(request.resource.data.registrationId)
        ).data.attemptToken == request.resource.data.attemptToken
        && get(
          /databases/$(database)/documents/registrations/$(request.resource.data.registrationId)
        ).data.studentId == request.resource.data.student.studentId
        && get(
          /databases/$(database)/documents/registrations/$(request.resource.data.registrationId)
        ).data.subjectId == request.resource.data.subjectId;

      allow read, update, delete: if isAdmin();
    }

    // =====================================================
    // STUDENT REQUESTS
    // score_view = ขออนุมัติดูคะแนนรายบุคคล
    // retake     = ขอสอบแก้
    // =====================================================
    match /examRequests/{requestId} {
      function validStudentRequest() {
        return signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.studentId is string
          && request.resource.data.studentName is string
          && request.resource.data.subjectId is string
          && request.resource.data.subjectCode is string
          && request.resource.data.submissionId is string
          && (
            request.resource.data.requestType == "score_view"
            || request.resource.data.requestType == "retake"
          )
          && request.resource.data.status == "pending";
      }

      allow create: if validStudentRequest();

      // นักศึกษาเห็นเฉพาะคำร้องของตัวเอง รวมผลอนุมัติคะแนนของตัวเอง
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
        );

      // เฉพาะ Admin เปลี่ยน pending -> approved/rejected และใส่คะแนนที่อนุมัติ
      allow update, delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /examSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
